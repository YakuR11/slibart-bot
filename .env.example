# ====== Discord ======
# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# Prefixe des commandes texte
PREFIX==
# ID de ton serveur : les slash commands y apparaissent tout de suite (sinon enregistrement global)
GUILD_ID=
# IDs Discord des admins du bot, separes par des virgules (commandes =addrb, =setrb, =resetcd...)
OWNER_IDS=
# Emoji des rokbux (le bot doit etre sur le serveur qui possede l'emoji)
RB_EMOJI=<:rokbux:1312821555927191634>
# ID du compte "banque du slip" dans la table profile
CASINO_ID=388
# mettre false pour desactiver les slash commands
SLASH_COMMANDS=true

# ====== Base de donnees MySQL / MariaDB ======
# avec docker compose, DB_HOST est force a "db" automatiquement
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-moi
DB_NAME=slip

# ====== Spotify (=musique) ======
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# obligatoire depuis fevrier 2026 : npm run spotify-auth
SPOTIFY_REFRESH_TOKEN=

# ====== Traduction (=trad) ======
# langue cible par defaut
TRANSLATE_TARGET=zh
# optionnel : ton email monte la limite gratuite de MyMemory a 50 000 caracteres/jour
TRANSLATE_EMAIL=

# ====== Paris sportifs (API-Football) ======
# https://dashboard.api-football.com → Account → My Access
SPORTS_API_KEY=

# ====== Activity Discord : Plinko avec interface (voir README) ======
# Developer Portal > OAuth2 > Client Secret (Reset Secret)
DISCORD_CLIENT_SECRET=
# Port interne du serveur web de l'Activity
ACTIVITY_PORT=3001
# Jeton du tunnel Cloudflare (Zero Trust > Networks > Tunnels), utilise par docker compose
CF_TUNNEL_TOKEN=

# Salons utilises par l'app (sinon le bot cherche des salons nommes "bot" et "daily")
# BOT_CHANNEL_ID=
# DAILY_CHANNEL_ID=
# Message de vie au demarrage et a l'arret (sinon un salon nomme "ops" ou "admin")
# OPS_CHANNEL_ID=
